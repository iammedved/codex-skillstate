{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["baseStateSha256", "state_patch", "action"],
  "additionalProperties": false,
  "properties": {
    "baseStateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "decisions", "files", "verification", "blockers", "failedApproaches", "nextAction", "finalResult"],
      "properties": {
        "facts": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 50 },
        "decisions": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 50 },
        "files": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 50 },
        "verification": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 50 },
        "blockers": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 50 },
        "failedApproaches": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 50 },
        "nextAction": { "type": ["string", "null"] },
        "finalResult": { "type": ["string", "null"] }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "path", "query", "maxBytes", "patch", "question", "result", "task", "expectedSha256"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["read_file", "search", "git_diff", "snapshot", "apply_patch", "ask", "finish", "worker"] },
        "path": { "type": ["string", "null"], "maxLength": 4096 },
        "query": { "type": ["string", "null"], "maxLength": 256 },
        "maxBytes": { "type": ["integer", "null"], "minimum": 1, "maximum": 65536 },
        "patch": { "type": ["string", "null"], "maxLength": 200000 },
        "question": { "type": ["string", "null"], "maxLength": 12000 },
        "result": { "type": ["string", "null"], "maxLength": 24000 },
        "task": { "type": ["string", "null"], "maxLength": 12000, "description": "Read-only worker task; all external effects remain prohibited by runtime authority." }
        ,"expectedSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$", "description": "Digest from a prior read_file result; verifies the file immediately before it is returned." }
      }
    }
  }
}
